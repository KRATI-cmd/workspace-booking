generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       Int       @id @default(autoincrement())
  name     String
  age      Int
  gender   String
  teamId   Int?
  bookings Booking[]
  team     Team?     @relation(fields: [teamId], references: [id])
}

model Team {
  id       Int       @id @default(autoincrement())
  name     String
  bookings Booking[]
  members  User[]
}

model Room {
  id       Int       @id @default(autoincrement())
  type     RoomType
  capacity Int
  bookings Booking[]
}

model Booking {
  id        Int      @id @default(autoincrement())
  slot      String
  createdAt DateTime @default(now())
  userId    Int? // optional
  teamId    Int? // optional
  roomId    Int // required
  room      Room     @relation(fields: [roomId], references: [id])
  team      Team?    @relation(fields: [teamId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
}

enum RoomType {
  PRIVATE
  CONFERENCE
  SHARED
}
